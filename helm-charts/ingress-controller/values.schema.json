{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingress-controller helm chart values schema",
  "description": "configuration values for ingress-controller helm chart",
  "type": "object",
  "properties": {
    "tlsSecurityProfile": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Old", "Intermediate", "Modern", "Custom"]
        },
        "custom": {
          "type": "object",
          "properties": {
            "ciphers": {
              "type": "array",
              "items": {
                "type": "string",
                "not": {
                  "enum": ["TLS_RSA_WITH_AES_128_CBC_SHA", "TLS_RSA_WITH_AES_256_CBC_SHA", "TLS_RSA_WITH_AES_128_GCM_SHA256", "TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA", "TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA", "TLS_RSA_WITH_3DES_EDE_CBC_SHA", "SSL_RSA_WITH_RC4_128_MD5", "TLS_RSA_EXPORT1024_WITH_RC4_56_SHA", "TLS_DHE_DSS_WITH_AES_128_CBC_SHA"]
                }
              }
            },
            "minTLSVersion": {
              "type": "string",
              "enum": ["VersionTLS10", "VersionTLS11", "VersionTLS12", "VersionTLS13"]
            }
          }
        }
      }
    }
  }
}
