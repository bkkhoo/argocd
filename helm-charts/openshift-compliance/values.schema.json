{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openshift-compliance helm chart values schema",
  "description": "configuration values for openshift-compliance helm chart",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string"
    },
    "complianceScan": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["Profile", "TailoredProfile"]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["master", "worker", "infra"]
          }
        },
        "schedule": {
          "type": "object",
          "properties": {
            "minHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "maxHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            }
          }
        }
      }
    }
  }
}
