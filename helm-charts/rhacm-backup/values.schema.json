{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rhacm helm chart values schema",
  "description": "configuration values for rhacm helm chart",
  "type": "object",
  "properties": {
    "rhacmBackup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "string",
          "enum": ["yes", "no"]
        },
        "namespace": {
          "type": "string"
        },
        "hourInterval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 23
        },
        "ttl": {
          "type": "string"
        },
        "s3": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "region": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "bucketPrefix": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            },
            "insecureSkipTLSVerify": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                }
              }
            }
          }
        }
      }
    },
    "syncHookImage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    }
  }
}
