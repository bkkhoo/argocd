{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openshift-gitops helm chart values schema",
  "description": "configuration values for openshift-gitops helm chart",
  "type": "object",
  "properties": {
    "deploymentType": {
      "type": "string",
      "enum": ["operator", "argocd", "all"]
    },
    "namespace": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string"
        },
        "argocd": {
          "type": "string"
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "autoscale": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                }
              }
            }
          }
        }
      }
    },
    "dex": {
      "type": "object",
      "properties": {
