        }
      }
    },
    "localUsers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "apiKey": {
            "type": "boolean"
          },
          "login": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "customCA": {
          "type": "string"
        }
      }
    },
    "appProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sourceRepos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "postSyncHookImage": {
      "type": "object",
