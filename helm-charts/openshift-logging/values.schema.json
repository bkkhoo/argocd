{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openshift-logging helm chart values schema",
  "description": "configuration values for openshift-logging helm chart",
  "type": "object",
  "properties": {
    "clusterName": {
      "type": "string"
    },
    "env": {
      "type": "string",
      "enum": ["dev", "uat", "prod"]
    },
    "sector": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
            },
            "memory": {
              "type": "string",
              "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^([+-]?[0-9.]+)([em]*[-+]?[0-9]*)$"
            },
            "memory": {
              "type": "string",
              "pattern": "^([+-]?[0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "string"
    },
    "outputs": {
      "type": "object",
      "properties": {
        "httpTimeout": {
          "type": "integer"
        },
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "tuning": {
          "type": "object",
          "properties": {
            "maxWrite": {
              "type": "integer",
              "maximum": 10485760
            }
          }
        },
        "ca": {
          "type": "object",
          "properties": {
            "configMap": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "application": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "secret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "secret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "secret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
