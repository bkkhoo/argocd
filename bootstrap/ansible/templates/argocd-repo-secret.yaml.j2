---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: argocd-repo-all-envs
  namespace: rhacm-policies
  labels:
    argocd.argoproj.io/secret-type: repository
    rhacm-policies/sync-hub-secret: "yes"
  annotations:
    rhacm-policies/structure: list
    rhacm-policies/target-name: argocd-repo
    rhacm-policies/target-namespace: openshift-gitops
stringData:
{% for env, value in _data.items() %}
  {{ env }}: '{{ value | to_json }}'
{% endfor %}
...
