---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: repo-{{ repo_name }}
  annotations:
    managed-by: argocd.argoproj.io
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  name: {{ repo_name }}
  project: iac-gitops
  type: git
  url: {{ repo_url }}
  username: {{ repo_username }}
  password: {{ repo_token }}
...
