{% for env, data in rhacm_backup.items() %}
---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ env }}-rhacm-backup
  namespace: rhacm-policies
  labels:
    sync-secret/env: {{ env }}
    sync-secret/type: no-sync
    sync-secret/app: rhacm-backup
    app.kubernetes.io/managed-by: rhacm
stringData:
  s3_url: {{ data.s3_url }}
  s3_region: {{ data.s3_region }}
  s3_bucket: {{ data.s3_bucket }}
  cloud: |
    [backupStorage]
    aws_access_key_id={{ data.aws_access_key_id }}
    aws_secret_access_key={{ data.aws_secret_access_key }}
{% endfor %}
...
