{
  "id": "out-openshift-s3",
  "type": "s3",
  "description": "odf s3 object store",
  "endpoint": "https://s3-openshift-storage.apps.cluster-f526q.dyn.redhatworkshops.io",
  "region": "",
  "bucket": "misc-s3-bucket-obc-e3a9d0c7-56f1-4054-ada4-708e2d8a5257",
  "awsAuthenticationMethod": "secret",
  "awsSecret": "openshift-s3-auth",
  "format": "json",
  "compress": "gzip",
  "baseFileName": "`CriblOut`",
  "fileNameSuffix": "`.${C.env[\"CRIBL_WORKER_ID\"]}.${__format}${__compression === \"gzip\" ? \".gz\" : \"\"}`",
  "systemFields": [],
  "streamtags": [
    "openshift-metrics"
  ],
  "enableAssumeRole": false,
  "durationSeconds": 3600,
  "reuseConnections": true,
  "rejectUnauthorized": true,
  "destPath": "",
  "maxConcurrentFileParts": 4,
  "verifyPermissions": true,
  "maxClosingFilesToBackpressure": 100,
  "stagePath": "$CRIBL_HOME/state/outputs/staging",
  "addIdToStagePath": true,
  "removeEmptyDirs": true,
  "partitionExpr": "C.Time.strftime(_time ? _time : Date.now()/1000, '%Y/%m/%d')",
  "maxFileSizeMB": 32,
  "maxFileOpenTimeSec": 300,
  "maxFileIdleTimeSec": 30,
  "maxOpenFiles": 100,
  "headerLine": "",
  "writeHighWaterMark": 64,
  "onBackpressure": "block",
  "deadletterEnabled": false,
  "onDiskFullBackpressure": "block",
  "forceCloseOnShutdown": true,
  "retrySettings": {
    "enabled": true,
    "initialBackoffMs": 10000,
    "backoffMultiplier": 2,
    "maxBackoffMs": 60000,
    "jitterPercent": 25
  },
  "orphans": {
    "disabled": false,
    "periodMin": 10
  },
  "objectACL": "private",
  "compressionLevel": "best_speed",
  "emptyDirCleanupSec": 300,
  "directoryBatchSize": 1000
}
