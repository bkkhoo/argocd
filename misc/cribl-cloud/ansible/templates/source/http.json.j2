{
  "id": "http",
  "description": "openshift clusterlogLogForwarder http output",
  "type": "http",
  "disabled": false,
  "sendToRoutes": true,
  "host": "0.0.0.0",
  "port": 10080,
  "pqEnabled": false,
  "streamtags": [
    "openshift-logging"
  ],
  "tls": {
    "disabled": false,
    "minVersion": "TLSv1.2",
    "certPath": "$CRIBL_CLOUD_CRT",
    "privKeyPath": "$CRIBL_CLOUD_KEY"
  },
  "maxActiveReq": 256,
  "maxRequestsPerSocket": 0,
  "enableProxyHeader": false,
  "captureHeaders": false,
  "activityLogSampleRate": 1000,
  "requestTimeout": 0,
  "socketTimeout": 0,
  "keepAliveTimeout": 5,
  "enableHealthCheck": false,
  "ipAllowlistRegex": "/.*/",
  "ipDenylistRegex": "/^$/",
  "criblAPI": "/cribl",
  "elasticAPI": "/elastic",
  "splunkHecAPI": "/services/collector",
  "splunkHecAcks": false,
  "authTokensExt": [
    {
      "description": "prod application token",
      "token": "{{ openshift_logging_bearer_tokens.prod.application }}"
    },
    {
      "description": "prod infrastructure token",
      "token": "{{ openshift_logging_bearer_tokens.prod.infrastructure }}"
    },
    {
      "description": "prod audit token",
      "token": "{{ openshift_logging_bearer_tokens.prod.audit }}"
    },
    {
      "description": "uat application token",
      "token": "{{ openshift_logging_bearer_tokens.uat.application }}"
    },
    {
      "description": "uat infrastructure token",
      "token": "{{ openshift_logging_bearer_tokens.uat.infrastructure }}"
    },
    {
      "description": "uat audit token",
      "token": "{{ openshift_logging_bearer_tokens.uat.audit }}"
    },
    {
      "description": "dev application token",
      "token": "{{ openshift_logging_bearer_tokens.dev.application }}"
    },
    {
      "description": "dev infrastructure token",
      "token": "{{ openshift_logging_bearer_tokens.dev.infrastructure }}"
    },
    {
      "description": "dev audit token",
      "token": "{{ openshift_logging_bearer_tokens.dev.audit }}"
    }
  ],
  "connections": [
    {}
  ]
}
