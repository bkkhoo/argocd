{
  "id": "infrastructure-log-transform",
  "conf": {
    "description": "transform infrastructure log",
    "functions": [
      {
        "id": "eval",
        "description": "add labels; pod_and and container_name labels disabled because of high cardinality",
        "filter": "true",
        "disabled": false,
        "conf": {
          "printUndefineds": false,
          "add": [
            {
              "name": "__labels",
              "value": "{}"
            },
            {
              "name": "__labels.log_type",
              "value": "__e.log_type"
            },
            {
              "name": "__labels.log_source",
              "value": "__e.log_source"
            },
            {
              "name": "__labels.cluster_name",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.cluster_name : null"
            },
            {
              "name": "__labels.cluster_env",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.env : null"
            },
            {
              "name": "__labels.cluster_sector",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.sector : null"
            },
            {
              "name": "__labels.node_name",
              "value": "__e.hostname ? __e.hostname : null"
            },
            {
              "name": "__labels.level",
              "value": "__e.level"
            },
            {
              "name": "__labels.kubernetes_namespace_name",
              "value": "__e.kubernetes && __e.kubernetes.namespace_name ? __e.kubernetes.namespace_name : null"
            },
            {
              "disabled": true,
              "name": "__labels.kubernetes_pod_name",
              "value": "__e.kubernetes && __e.kubernetes.pod_name ? __e.kubernetes.pod_name : null"
            },
            {
              "disabled": true,
              "name": "__labels.kubernetes_container_name",
              "value": "__e.kubernetes && __e.kubernetes.container_name ? __e.kubernetes.container_name : null"
            }
          ],
          "remove": [],
          "keep": []
        },
        "final": false
      },
      {
        "id": "eval",
        "description": "remove fields that are not useful",
        "filter": "true",
        "disabled": false,
        "conf": {
          "printUndefineds": false,
          "add": [],
          "remove": [
            "openshift",
            "kubernetes.namespace_id",
            "kubernetes.pod_id",
            "kubernetes.container_id",
            "kubernetes.namespace_labels.kubernetes_io_metadata_name",
            "kubernetes.namespace_labels.pod-security_kubernetes_io*",
            "kubernetes.namespace_labels.olm_operatorgroup_uid*",
            "kubernetes.annotations['alm-examples']"
          ],
          "keep": []
        },
        "final": false
      },
      {
        "id": "code",
        "description": "remove annotations that are not useful, pattern matching",
        "filter": "true",
        "disabled": false,
        "conf": {
          "maxNumOfIterations": 5000,
          "activeLogSampleRate": 1000,
          "useUniqueLogChannel": true,
          "code": "const anns = __e['kubernetes'] && __e['kubernetes']['annotations'];\n\nif (anns) {\n  Object.keys(anns).forEach(k => {\n    if (k.startsWith('k8s.ovn.org/pod-networks') ||\n        k.startsWith('k8s.v1.cni.cncf.io/network-status') ||\n        k.startsWith('olm') ||\n        k.startsWith('operator') ||\n        k.startsWith('features.operators')) {\n      delete anns[k];\n    }\n  });\n}"
        },
        "final": false
      },
      {
        "id": "sampling",
        "description": "retain only 20% of debug/info/default(event with not level) event",
        "filter": "['info', 'debug', \"default\"].includes(level.toLowerCase())",
        "disabled": false,
        "conf": {
          "rules": [
            {
              "filter": "true",
              "rate": 5
            }
          ]
        },
        "final": true
      }
    ],
    "streamtags": [
      "openshift-logging"
    ],
    "groups": {},
    "output": "default"
  }
}
