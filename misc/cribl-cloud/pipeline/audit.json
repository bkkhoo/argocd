{
  "id": "audit-label-log",
  "conf": {
    "description": "label audit log",
    "functions": [
      {
        "id": "eval",
        "description": "add cluster name, cluster env, cluster sector, verb, resource labels",
        "filter": "true",
        "conf": {
          "printUndefineds": false,
          "add": [
            {
              "disabled": false,
              "name": "__labels",
              "value": "{}"
            },
            {
              "disabled": false,
              "name": "__labels.log_type",
              "value": "__e.log_type"
            },
            {
              "name": "__labels.cluster_name",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.cluster_name : null"
            },
            {
              "disabled": false,
              "name": "__labels.cluster_env",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.env : null"
            },
            {
              "disabled": false,
              "name": "__labels.cluster_sector",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.sector : null"
            },
            {
              "disabled": false,
              "name": "__labels.node_name",
              "value": "__e.hostname ? __e.hostname : null"
            },
            {
              "disabled": false,
              "name": "__labels.log_source",
              "value": "__e.log_source"
            },
            {
              "disabled": false,
              "name": "__labels.verb",
              "value": "__e.verb && __e.verb ? __e.verb: null"
            },
            {
              "disabled": false,
              "name": "__labels.resource",
              "value": "__e.objectRef ? __e.objectRef.resource : null"
            }
          ],
          "remove": [
            "openshift",
            "auditID"
          ]
        }
      },
      {
        "id": "drop",
        "description": "drop get, list, watch, unless its for secret",
        "filter": "['get', 'list', 'watch'].includes(verb) && objectRef.resource != 'secret'",
        "final": true,
        "conf": {}
      }
    ],
    "streamtags": [],
    "groups": {},
    "output": "default"
  }
}
