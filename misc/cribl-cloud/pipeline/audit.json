{
  "id": "audit-log-transform",
  "conf": {
    "description": "transform audit log",
    "functions": [
      {
        "id": "eval",
        "description": "add labels",
        "filter": "true",
        "disabled": false,
        "conf": {
          "printUndefineds": false,
          "add": [
            {
              "name": "__labels",
              "value": "{}"
            },
            {
              "name": "__labels.log_type",
              "value": "__e.log_type"
            },
            {
              "name": "__labels.log_source",
              "value": "__e.log_source"
            },
            {
              "name": "__labels.cluster_name",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.cluster_name : null"
            },
            {
              "name": "__labels.cluster_env",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.env : null"
            },
            {
              "name": "__labels.cluster_sector",
              "value": "__e.openshift && __e.openshift.labels ? __e.openshift.labels.sector : null"
            },
            {
              "name": "__labels.node_name",
              "value": "__e.hostname ? __e.hostname : null"
            },
            {
              "name": "__labels.verb",
              "value": "__e.verb && __e.verb ? __e.verb: null"
            },
            {
              "name": "__labels.namespace",
              "value": "__e.objectRef ? __e.objectRef.namespace : null"
            },
            {
              "name": "__labels.resource",
              "value": "__e.objectRef ? __e.objectRef.resource : 'nonResource'"
            },
            {
              "name": "__labels.response_status",
              "value": "__e.responseStatus && __e.responseStatus.code ? __e.responseStatus.code: null"
            }
          ],
          "remove": [],
          "keep": []
        },
        "final": false
      },
      {
        "id": "eval",
        "description": "remove fields that are not useful",
        "filter": "true",
        "disabled": false,
        "conf": {
          "printUndefineds": false,
          "add": [],
          "remove": [
            "openshift",
            "auditID",
            "objectRef.resourceVersion",
            "objectRef.uid",
            "user.uid",
            "user.extra['authentication.kubernetes.io/credential-id']",
            "user.extra['authentication.kubernetes.io/node-uid']",
            "user.extra['authentication.kubernetes.io/pod-uid']"
          ],
          "keep": []
        },
        "final": false
      },
      {
        "id": "drop",
        "description": "drop get, list, watch event, unless its for secret; drop non-2XX subjectaccessreviews, tokenreviews, and leases event",
        "filter": "(['get', 'list', 'watch'].includes(verb) && objectRef.resource != 'secrets') || (['subjectaccessreviews', 'tokenreviews', 'leases'].includes(objectRef.resource) && (responseStatus.code == 200 || responseStatus.code == 201))",
        "disabled": false,
        "conf": {},
        "final": true
      }
    ],
    "streamtags": [
      "openshift-logging"
    ],
    "groups": {},
    "output": "default"
  }
}
